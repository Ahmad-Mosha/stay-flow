# Copy to .env for local development. Matches the services in compose.yaml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://stayflow:stayflow@localhost:5432/stayflow
# The web app's origin, when it is served from another port or domain than the API.
TRUSTED_ORIGINS=http://localhost:3001
# Mailpit from compose.yaml catches every email; read them at http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Stay Flow <bookings@stayflow.test>
# Where the links in emails point.
WEB_URL=http://localhost:3001
