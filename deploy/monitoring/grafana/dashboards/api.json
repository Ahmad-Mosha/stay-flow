          "expr": "1 - (sum(increase(http_request_duration_seconds_count{job=\"api\", status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_request_duration_seconds_count{job=\"api\", route!~\"/health/.*\"}[$__range]))",
