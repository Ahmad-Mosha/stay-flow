    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Counts for the time range picked at the top right. **Double bookings blocked** are bookings that raced another for the same room at the same moment: PostgreSQL's exclusion constraint refused the overlap, and the booking moved on to the next free room. None got through.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
