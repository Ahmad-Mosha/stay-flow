    {
      "type": "timeseries",
      "title": "Stays, by step and by who took it",
      "description": "Per minute. Check-ins, check-outs, no-shows (marked by the host or the night audit) and cancellations (by the guest or the host).",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^checked_in(.*)",
            "renamePattern": "Checked in$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^checked_out(.*)",
            "renamePattern": "Checked out$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^no_show(.*)",
            "renamePattern": "No-show$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^cancelled(.*)",
            "renamePattern": "Cancelled$1"
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status, actor) (rate(stayflow_reservation_status_changes_total{status=~\"checked_in|checked_out|no_show|cancelled\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{status}} by {{actor}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "/min",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "barAlignment": 0,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Checked in.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Checked out.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^No-show.*"
            },
            "properties": [
