{
	# Let's Encrypt sends certificate expiry warnings here.
	email {$ACME_EMAIL}
	# Counts and times every request for Prometheus, labelled by site.
	metrics {
		per_host
	}
}

(security_headers) {
	header {
		# Applied as the response goes out, so they replace what the app sets, as Grafana does,
		# instead of sending the header twice.
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Caddy gets and renews the certificate for this domain, and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip
	import security_headers

	# The browser calls the API on the site's own origin, so the session cookie stays first-party.
	# While a deploy restarts a container, Caddy holds new requests for up to 15 s instead of
	# answering 502. It retries a POST only when the connection failed, so none runs twice.
	handle /v1/* {
		reverse_proxy api:3000 {
			lb_try_duration 15s
		}
	}

	handle {
		reverse_proxy web:3001 {
			lb_try_duration 15s
		}
	}

	log
}

# Grafana, behind its own login. A site of its own keeps Grafana's cookies apart from the app's.
grafana.{$DOMAIN} {
	encode zstd gzip
	import security_headers
	# Grafana's own metrics are for Prometheus, on the private network.
	respond /metrics 404
	reverse_proxy grafana:3000
	log
}

# Prometheus reads Caddy's metrics here. The port is not published, so only the private network
# reaches it.
:2020 {
	metrics
}
