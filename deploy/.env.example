# Copy to .env next to compose.yaml on the server and fill it in. The real file stays there.

# The site's domain. Caddy gets its HTTPS certificate for it, so it must point at this server.
DOMAIN=stayflow.duckdns.org
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=you@example.com

# Letters and digits only, since it goes into a connection URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# Mailpit on the server catches every email. Point this at a real SMTP server to send them.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Stay Flow <bookings@stayflow.test>

# The commit whose images run. deploy.sh sets it.
IMAGE_TAG=latest
